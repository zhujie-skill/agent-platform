# Runtime
APP_NAME=Agent Tool Platform
APP_ENV=development
APP_VERSION=0.5.0
API_HOST=127.0.0.1
API_PORT=8000
API_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Cloud PostgreSQL
# Leave empty to run the platform in degraded mode without a database.
# Use a dedicated account and require TLS for a real cloud database.
# Example:
# DATABASE_URL=postgresql+psycopg://user:password@host:5432/database?sslmode=require
DATABASE_URL=
DATABASE_CONNECT_TIMEOUT_SECONDS=5
SQL_ECHO=false

# Phase 2 local identity provider. Requests may override this with X-Local-Principal.
LOCAL_PRINCIPAL_EXTERNAL_ID=local-admin

# SQL Tool datasource (must be a separate read-only account/connection).
# Deliberately leave empty until a read-only role has been created.
# The API rejects an exact reuse of DATABASE_URL.
SQL_TOOL_DATABASE_URL=
SQL_TOOL_ALLOWED_SCHEMAS=["tool_data"]
SQL_TOOL_STATEMENT_TIMEOUT_MS=5000
SQL_TOOL_DEFAULT_MAX_ROWS=100
SQL_TOOL_ABSOLUTE_MAX_ROWS=1000

# Phase 3 HTTP Tool allowlist and deployed URL indirection.
HTTP_TOOL_ALLOWED_ORIGINS=["http://127.0.0.1:8000"]
HTTP_HEALTH_CHECK_URL=http://127.0.0.1:8000/api/v1/health
HTTP_TOOL_MAX_RESPONSE_BYTES=1000000

# Only endpoints in this exact allowlist may be registered as external MCP Servers.
MCP_ALLOWED_ENDPOINTS=["http://127.0.0.1:8101/mcp"]
MCP_CONNECT_TIMEOUT_SECONDS=10

# MCP facade: which governed Agent/principal a standard MCP Client acts through.
PLATFORM_API_URL=http://127.0.0.1:8000/api/v1
PLATFORM_AGENT_ID=00000000-0000-0000-0000-000000000101
PLATFORM_PRINCIPAL=local-admin

# Web server-side API address
API_BASE_URL=http://127.0.0.1:8000
# Optional browser-side override. The local default already points to 127.0.0.1:8000.
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000

